# Copy this file to .env and fill in your values. Never commit .env.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here

# Free models only. Run:  python -m job_matcher models   and copy one ID.
# It must end in ":free" (the app refuses anything else).
MODEL=

# How many jobs the LLM scores per company (keep low on free models)
MAX_JOBS_TO_SCORE=8

# Only for the deployed site: visitors must enter this password.
# Leave empty when running on your own computer.
APP_PASSWORD=
