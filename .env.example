# Copy this file to .env and fill in your values. Never commit .env.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here

# Free models only. Go to https://openrouter.ai/models, filter "free",
# copy a model ID ending in ":free" (the app refuses anything else).
MODEL=

# How many jobs the LLM scores per company (keep low on free models)
MAX_JOBS_TO_SCORE=8
